{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "lib": ["ES2023"],
    "types": ["node"],

    "rootDir": "./lab1/node-express/src",
    "outDir": "./lab1/node-express/dist",

    "strict": false,
    "noUncheckedIndexedAccess": true,

    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noFallthroughCasesInSwitch": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "sourceMap": true
  },
  "include": ["lab1/node-express/src"]
}